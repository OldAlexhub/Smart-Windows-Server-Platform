{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexus Server",
  "mainBinaryName": "Nexus",
  "version": "0.1.0",
  "identifier": "com.nexus.server",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Nexus Server",
        "url": "index.html",
        "width": 1320,
        "height": 860,
        "minWidth": 420,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
